# Pollux backend — local .env template.
# Copy to .env (gitignored) and fill in real values. Never commit real
# secrets here — this file only holds placeholder markers.

# Postgres superuser password for the local docker-compose `postgres`
# service AND the DATABASE_URL below must match (same value, both read by
# docker-compose.yml via ${POSTGRES_PASSWORD} interpolation).
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
DATABASE_URL=postgresql://leto_user:<POSTGRES_PASSWORD>@postgres:5432/leto_db

# Required — backend refuses to start without it (app/core/config.py).
SECRET_KEY=<SECRET_KEY>

# Required — backend refuses to start without it (app/services/token_crypto.py).
# Encrypts/decrypts stored Google Drive refresh tokens.
DRIVE_TOKEN_SECRET=<DRIVE_TOKEN_SECRET>

# Required — backend refuses to start without it (app/routers/drive.py).
# Firma HMAC del parámetro `state` en el callback OAuth de Drive (protección CSRF).
DRIVE_STATE_SECRET=<DRIVE_STATE_SECRET>

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:4001

ADMIN_SEED_EMAIL=<ADMIN_SEED_EMAIL>
ADMIN_SEED_PASSWORD=<ADMIN_SEED_PASSWORD>
